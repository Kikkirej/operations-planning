# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit the filled .env file. All values here are placeholder secrets
# that MUST be rotated before any environment is exposed beyond localhost.

# Keycloak admin credentials
# Username for the Keycloak master realm admin account
KEYCLOAK_ADMIN=admin
# Password for the Keycloak master realm admin account
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

# Keycloak PostgreSQL credentials
# Database username for Keycloak's dedicated PostgreSQL schema
KC_DB_USERNAME=keycloak
# Database password for Keycloak's dedicated PostgreSQL schema
KC_DB_PASSWORD=CHANGE_ME_BEFORE_USE
# PostgreSQL database name for Keycloak
POSTGRES_DB=keycloak
# PostgreSQL superuser (must match KC_DB_USERNAME for Keycloak setup)
POSTGRES_USER=keycloak
# PostgreSQL superuser password (must match KC_DB_PASSWORD)
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE

# Config Server Basic auth credentials
# Username for Config Server HTTP basic authentication
CONFIG_SERVER_USERNAME=configuser
# Password for Config Server HTTP basic authentication
CONFIG_SERVER_PASSWORD=CHANGE_ME_BEFORE_USE

# Absolute path on the host to the configuration repository directory
# Example: /home/user/my-config-repo  or  /opt/ops/config
CONFIG_REPO_PATH=/path/to/your/config/repository

# Keycloak public URL (used by services for JWT validation)
KEYCLOAK_URL=https://auth.ops.local

# Spring Boot Admin Keycloak client secret
# OAuth2 client secret for the spring-boot-admin client in Keycloak
KEYCLOAK_SBA_CLIENT_SECRET=CHANGE_ME_BEFORE_USE

# Application PostgreSQL credentials (distinct from Keycloak PostgreSQL)
# Database name for application data (separate from Keycloak's database)
APP_POSTGRES_DB=app_db
# Application database username
APP_POSTGRES_USER=appuser
# Application database password
APP_POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE

# Neo4j graph database credentials
# Password for the built-in neo4j user in the Neo4j graph database
NEO4J_PASSWORD=CHANGE_ME_BEFORE_USE
